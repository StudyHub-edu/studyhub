# Copy this file to .env and fill in your own values. Never commit .env.

# Port the whole StudyHub app (main site + Community/Calendar + Library) runs on.
PORT=3000

# Same Supabase project used by public/js/config.js. Only the public anon key
# is needed here (never the service_role/secret key).
SUPABASE_URL=https://rhcpnzduqishmbmfdwat.supabase.co
SUPABASE_ANON_KEY=sb_publishable_UjrKKitdiei3AQLfDZUm-g_D0StWem1

# Required for admin account and institution creation. Copy the secret
# service-role key from Supabase -> Project Settings -> API Keys into your
# local backend/.env only. Never expose it to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Community username/password endpoints are disabled by default.
# TEACHER_CODE is only needed if ALLOW_LEGACY_COMMUNITY_AUTH=1 for local tests.
TEACHER_CODE=

# Protects Library actions that add/edit/delete books. Use a random secret
# containing at least 32 characters; leave empty to keep editing disabled.
LIBRARIAN_CODE=

# --- Gmail SMTP for Supabase Auth emails (OTP codes, password reset) -------
# These two are NOT read directly by this Node app. Paste them into the
# Supabase Dashboard instead: Authentication -> Settings -> SMTP Settings.
# They're listed here only so you keep them together with your other secrets.
#   Host: smtp.gmail.com   Port: 465   Username: your Gmail address
#   Password: the 16-character Gmail App Password (not your normal password)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
